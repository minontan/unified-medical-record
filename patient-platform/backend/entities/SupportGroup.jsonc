{
  "name": "SupportGroup",
  "type": "object",
  "title": "Support Group",
  "description": "A support group for chronic disease patients",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "condition_focus": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "hypertension",
          "diabetes",
          "hyperlipidaemia",
          "general"
        ]
      }
    },
    "member_emails": {
      "type": "string",
      "description": "Comma separated member emails"
    },
    "member_count": {
      "type": "integer",
      "default": 0
    },
    "cover_image": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "description",
    "condition_focus"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}