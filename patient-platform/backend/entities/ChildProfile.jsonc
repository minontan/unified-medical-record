{
  "name": "ChildProfile",
  "type": "object",
  "title": "Child Profile",
  "description": "Profile of a child managed by a parent/guardian user",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Child's full name"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Child's date of birth"
    },
    "sex": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ],
      "description": "Biological sex"
    },
    "blood_type": {
      "type": "string",
      "enum": [
        "A+",
        "A-",
        "B+",
        "B-",
        "AB+",
        "AB-",
        "O+",
        "O-",
        "unknown"
      ],
      "default": "unknown"
    },
    "known_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Known medical conditions or diagnoses"
    },
    "allergies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Known allergies"
    },
    "notes": {
      "type": "string",
      "description": "General notes about the child's health"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "transfer_initiated",
        "transferred"
      ],
      "default": "active",
      "description": "active = parent manages; transfer_initiated = awaiting child to accept; transferred = child now manages their own account"
    },
    "transfer_to_email": {
      "type": "string",
      "description": "Email address of the child's own account when transfer is initiated"
    },
    "transfer_initiated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the transfer of care was initiated"
    },
    "avatar_color": {
      "type": "string",
      "description": "Hex color for the child's avatar"
    }
  },
  "required": [
    "full_name",
    "date_of_birth",
    "sex"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}